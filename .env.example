# CIVIC PULSE Configuration Template
# Copy this file to .env and adjust variables as needed

APP_NAME="Civic Pulse"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development with zero external dependencies, SQLite is supported out of the box:
DATABASE_URL=sqlite:///./civic_pulse.db
# For production PostgreSQL (with or without PostGIS):
# DATABASE_URL=postgresql+psycopg2://civic_user:civic_password@localhost:5432/civic_pulse

# CORS Frontend Origins (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload and Storage
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=5

# AI & Geospatial Intelligence Thresholds
AI_MODEL_NAME=tfidf_logreg_baseline
AI_CONFIDENCE_THRESHOLD=0.65
DUPLICATE_DISTANCE_METERS=150
DUPLICATE_SIMILARITY_THRESHOLD=0.70

# Priority Scoring Configuration
PRIORITY_SAFETY_WEIGHT=0.35
PRIORITY_SEVERITY_WEIGHT=0.25
PRIORITY_AGE_WEIGHT=0.20
PRIORITY_ACCESSIBILITY_WEIGHT=0.10
PRIORITY_DUPLICATE_WEIGHT=0.10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Email Notifications (Internal fallback works automatically if unconfigured)
EMAIL_PROVIDER_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@civicpulse.local
